# ============================================
#   TruthAI — Environment Configuration
# ============================================
# Copy this file to .env and fill in your key
# Get a FREE Gemini API key: https://aistudio.google.com/apikey

# Single key:
GEMINI_API_KEY=your_gemini_api_key_here

# OR multiple keys for automatic rotation on rate limit (429).
# Comma-separated. When one key hits its quota, the app switches to the
# next one automatically — no restart, no code change. Just add more keys.
# GEMINI_API_KEYS=key1,key2,key3

PORT=3000

# Optional hardening:
# RATE_LIMIT: per-IP cap on /api/analyze (default "10 per minute")
# RATE_LIMIT=10 per minute
# ALLOWED_ORIGINS: comma-separated sites allowed to call the API cross-origin.
# Leave unset for same-origin only (all the bundled frontend needs).
# ALLOWED_ORIGINS=https://yourdomain.com
